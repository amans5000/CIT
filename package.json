{
  "name": "cit9-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CIT 9.0 — Secure Online Assessment Platform Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:services:down": "docker compose -f docker-compose.dev.yml down",
    "dev:api": "npm run dev --workspace=@cit9/api",
    "dev:web": "npm run dev --workspace=@cit9/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run db:generate --workspace=@cit9/database",
    "db:push": "npm run db:push --workspace=@cit9/database",
    "db:migrate": "npm run db:migrate --workspace=@cit9/database",
    "db:seed": "npm run db:seed --workspace=@cit9/database"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
