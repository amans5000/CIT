# ==============================================================================
# CIT 9.0 — Environment Configuration Template (.env.example)
# DO NOT COMMIT THE REAL .env FILE WITH PRODUCTION SECRETS
# ==============================================================================

# --- Node Environment ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Database Configuration (PostgreSQL 16) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cit9_db?schema=public
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cit9_db
DB_PORT=5432

# --- Redis Configuration (Redis 7) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Application Security Secrets ---
# Generate using: openssl rand -hex 64
SESSION_SECRET=replace_with_64_byte_cryptographic_random_string_for_session
COOKIE_SECRET=replace_with_64_byte_cryptographic_random_string_for_cookies
SESSION_TTL_HOURS=24

# --- Google OAuth 2.0 / OpenID Connect ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- Rate Limiting Policy ---
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# --- Frontend Public Variables (NEXT_PUBLIC_*) ---
# ONLY variables intended for public browser consumption may use NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
